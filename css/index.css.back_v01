h2 {
    color: red;
}

.container {
    width: 504px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: grid;
    place-items: center;
    min-height: 100vh;
}

.container h2 {
    font-size: 24px;
    text-align: center;
}
.top_text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
}

.top_text div p {
    width: 150px;
    border: 1px solid red;
    text-align: center;
}
.item-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    /* border: 1px solid violet; */
    margin: 0 auto;
    width: 100%;
    /* padding: 20px; */
}

.item-card li {
    width: 100%;
    height: 50px;
}

.item-card li a {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid gray;
}

.item-card li a:active,
.item-card li a:focus {
    border-color: blue;
}

.btn {
    width: 100%;
    height: 50px;
    border: 1px solid red;
    display: flex;
    justify-content: center;
    align-items: center;
}

.btn p:hover {
    color: red;
}
